# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key

# Gmail OAuth (Google Cloud Console)
# Create OAuth 2.0 credentials at: https://console.cloud.google.com/apis/credentials
# Add authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/integrations/gmail/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Slack OAuth (Slack API)
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret

# Notion Integration
NOTION_CLIENT_ID=your_notion_client_id
NOTION_CLIENT_SECRET=your_notion_client_secret

# App Configuration
# Set to your deployment URL (e.g., https://yourdomain.com)
# This URL is used for OAuth redirects - must match Google Cloud Console settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
